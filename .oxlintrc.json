{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist/**", "node_modules/**", "repository-mock-data/**", "schema/**", "src/__generated__/**"],
  "categories": {
    "correctness": "off",
    "nursery": "off",
    "pedantic": "off",
    "perf": "off",
    "restriction": "off",
    "style": "off",
    "suspicious": "off"
  },
  "rules": {
    "complexity": [
      "error",
      {
        "max": 8,
        "variant": "classic"
      }
    ],
    "max-depth": [
      "error",
      {
        "max": 3
      }
    ]
  }
}
