{
  "$schema": "https://typedoc.org/schema.json",

  "entryPoints": ["src/index.ts"],
  "entryPointStrategy": "resolve",

  "emit": "none",
  "commentStyle": "jsdoc",

  "excludeExternals": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,

  "validation": {
    "notDocumented": true,
    "notExported": false,
    "invalidLink": true,
    "invalidPath": true,
    "rewrittenLink": false,
    "unusedMergeModuleWith": true
  },

  "requiredToBeDocumented": [
    "Enum",
    "EnumMember",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Property",
    "Method",
    "Accessor",
    "TypeAlias"
  ],

  "externalSymbolLinkMappings": {
    "@simulacrum/foundation-simulator": {
      "FoundationSimulator": "https://www.npmjs.com/package/@simulacrum/foundation-simulator"
    }
  },

  "treatValidationWarningsAsErrors": true
}
