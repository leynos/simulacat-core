{
  "name": "simulacat-core",
  "version": "0.6.4",
  "description": "Provides common functionality to frontend app and plugins.",
  "keywords": [
    "emulation",
    "github-api",
    "integration testing",
    "mock",
    "mocking",
    "simulation"
  ],
  "bugs": {
    "url": "https://github.com/thefrontside/simulacrum/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thefrontside/simulacrum.git",
    "directory": "packages/github-api"
  },
  "packageManager": "bun@1.3.11",
  "bin": "bin/start.cjs",
  "files": [
    "README.md",
    "dist",
    "src",
    "schema",
    "repository-mock-data"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "bench": "bun test --bench",
    "build": "tsdown",
    "check:types": "bun run generate && bunx tsc --noEmit",
    "fmt": "bunx @biomejs/biome format --write .",
    "generate": "graphql-codegen",
    "lint": "bunx @biomejs/biome lint .",
    "prepack": "bun run generate && bun run build",
    "start": "node --experimental-transform-types --watch ./example/start.ts",
    "start:bin": "node ./bin/start.cjs",
    "sync:schema:rest": "node --experimental-transform-types ./sync.ts",
    "test": "bun test --max-concurrency=1 tests",
    "test:watch": "bun test --watch tests",
    "tsc": "bun run check:types"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@graphql-tools/utils": "^11.1.0",
    "@simulacrum/foundation-simulator": "^0.8.0",
    "assert-ts": "^0.3.4",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@aboviq/bun-test-cucumber": "^0.2.0",
    "@arethetypeswrong/core": "^0.18.4",
    "@biomejs/biome": "^2.5.1",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-resolvers": "^6.0.2",
    "@octokit/graphql": "^9.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.4",
    "bun-types": "^1.3.14",
    "fast-check": "^4.8.0",
    "markdownlint-cli2": "^0.22.1",
    "oxlint": "^1.71.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.6",
    "fast-uri": "3.1.2",
    "http-proxy-middleware": "3.0.7",
    "js-yaml": "5.1.0",
    "lodash": "4.18.1",
    "markdown-it": "14.2.0",
    "qs": "6.15.2",
    "shell-quote": "1.8.4",
    "ws": "8.21.0"
  },
  "inlinedDependencies": {
    "starfx": "0.15.0"
  },
  "main": "./dist/index.cjs"
}
