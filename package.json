{
  "name": "simulacat-core",
  "version": "0.6.4",
  "description": "Provides common functionality to frontend app and plugins.",
  "keywords": [
    "emulation",
    "github-api",
    "integration testing",
    "mock",
    "mocking",
    "simulation"
  ],
  "bugs": {
    "url": "https://github.com/thefrontside/simulacrum/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thefrontside/simulacrum.git",
    "directory": "packages/github-api"
  },
  "packageManager": "bun@1.3.11",
  "bin": "bin/start.cjs",
  "files": [
    "README.md",
    "dist",
    "src",
    "schema",
    "repository-mock-data"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "audit": "bun run scripts/run-audit.mjs",
    "bench": "bun test --bench",
    "build": "tsdown",
    "check:types": "bun run generate && bunx tsc --noEmit",
    "docs:check": "typedoc --options typedoc.json",
    "fmt": "bunx @biomejs/biome format --write .",
    "generate": "graphql-codegen",
    "lint": "bunx @biomejs/biome lint .",
    "prepack": "bun run generate && bun run build",
    "start": "node --experimental-transform-types --watch ./example/start.ts",
    "start:bin": "node ./bin/start.cjs",
    "sync:schema:rest": "node --experimental-transform-types ./sync.ts",
    "test": "bun test --max-concurrency=1 tests",
    "test:watch": "bun test --watch tests",
    "tsc": "bun run check:types"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@graphql-tools/utils": "^12.0.3",
    "@simulacrum/foundation-simulator": "^0.8.0",
    "assert-ts": "^0.3.4",
    "express": "^5.3.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@aboviq/bun-test-cucumber": "^0.2.0",
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@octokit/graphql": "^9.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "bun-types": "^1.4.3",
    "fast-check": "^4.10.2",
    "markdownlint-cli2": "^0.23.3",
    "oxlint": "^1.87.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@fastify/busboy": "3.2.2",
    "@graphql-tools/executor-legacy-ws": "1.1.37",
    "@graphql-tools/utils": "12.0.3",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.9",
    "fast-uri": "3.1.8",
    "http-proxy-middleware": "3.0.7",
    "immutable": "5.1.9",
    "katex": "0.19.0",
    "linkify-it": "5.0.2",
    "lodash": "4.18.1",
    "markdown-it": "14.3.2",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "shell-quote": "1.12.0",
    "smol-toml": "1.9.1",
    "ws": "8.21.0"
  },
  "inlinedDependencies": {
    "effection": "4.0.3",
    "starfx": "0.16.1"
  },
  "main": "./dist/index.cjs"
}
